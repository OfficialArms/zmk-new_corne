#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        ALT_WINDOWS: ALT_WINDOWS {
            compatible = "zmk,behavior-tap-dance";
            label = "ALT_WINDOWS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT>, <&kp LEFT_WIN>;
        };

        TAP_PREF: TAP_PREF {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_PREF";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        SHIFT_CAPS: SHIFT_CAPS {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_CAPS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPSLOCK>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Screenshot-Left {
            bindings = <&Screenshot>;
            key-positions = <14 15 16>;
            layers = <0>;
        };

        Screenshot-Right {
            bindings = <&Screenshot>;
            key-positions = <26 25 24>;
            layers = <0>;
        };

        Home {
            bindings = <&kp HOME>;
            key-positions = <23 24>;
            layers = <2>;
        };

        End {
            bindings = <&kp END>;
            key-positions = <25 24>;
            layers = <2>;
        };

        Pg-Down {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <23 24 25>;
            layers = <2>;
        };

        Pg-Up {
            bindings = <&kp PAGE_UP>;
            key-positions = <9 23 25>;
            layers = <2>;
        };

        ShiftTab {
            bindings = <&ShiftTab>;
            key-positions = <1 0>;
            layers = <0>;
        };

        Layer-3 {
            bindings = <&mo 3>;
            key-positions = <43 46>;
            layers = <0>;
        };
    };

    macros {
        Screenshot: Screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(S))>;
            label = "SCREENSHOT";
        };

        ShiftTab: ShiftTab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(TAB)>;
            label = "SHIFTTAB";
        };

        IncreaseMouseSpeed: Increase_Mouse_Speed {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mmv MOVE_X(100) &mmv MOVE_Y(100)>;
            label = "INCREASE_MOUSE_SPEED";
        };

        DecreaseMouseSpeed: DecreaseMouseSpeed {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mmv MOVE_X(-100) &mmv MOVE_Y(-100)>;
            label = "DECREASEMOUSESPEED";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Main {
            display-name = "Main";
            bindings = <
&kp TAB           &kp Q  &kp W  &kp E         &kp R  &kp T                                                 &mmv MOVE_UP                     &kp Y      &kp U  &kp I          &kp O    &kp P     &kp EQUAL
&kp LEFT_CONTROL  &kp A  &kp S  &kp D         &kp F  &kp G                                 &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp H      &kp J  &kp K          &kp L    &kp SEMI  &kp SQT
&SHIFT_CAPS       &kp Z  &kp X  &kp C         &kp V  &kp B                   &kp C_MUTE                    &mmv MOVE_DOWN                   &kp N      &kp M  &kp COMMA      &kp DOT  &kp FSLH  &kp MINUS
                                &ALT_WINDOWS  &mo 1  &mt LEFT_CONTROL SPACE                                                                 &kp SPACE  &mo 2  &kp BACKSPACE
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
            label = "Main";
        };

        Numbers {
            display-name = "Numbers";
            bindings = <
&kp ESCAPE  &kp F1  &kp F2  &kp F3  &kp F4   &kp F5                                 &mmv MOVE_UP                     &mkp LCLK  &kp N7                      &kp N8        &TAP_PREF LEFT_BRACKET N9  &trans         &trans
&trans      &kp F6  &kp F7  &kp F8  &kp F9   &kp F10                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &mkp RCLK  &kp NUMBER_4                &kp N5        &kp NUMBER_6               &trans         &kp GRAVE
&trans      &trans  &trans  &trans  &kp F11  &kp F12  &kp C_MUTE                    &mmv MOVE_DOWN                   &mkp MCLK  &kp NUMBER_1                &kp NUMBER_2  &kp NUMBER_3               &kp BACKSLASH  &trans
                            &trans  &trans   &trans                                                                  &kp ENTER  &TAP_PREF RIGHT_BRACKET N0  &kp DELETE
            >;

            sensor-bindings =
                <&inc_dec_kp C_AC_SCROLL_UP C_AC_SCROLL_DOWN>,
                <&rsr_trans>;
        };

        Move {
            display-name = "Move";
            bindings = <
&kp ESCAPE  &none           &msc SCRL_UP    &mmv MOVE_UP    &msc SCRL_DOWN   &none                                      &mmv MOVE_UP                     &trans  &kp C_AC_BACK        &kp UP_ARROW  &kp C_AC_FORWARD     &kp C_NEXT  &kp C_VOLUME_UP
&trans      &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_RIGHT            &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &trans  &kp LEFT             &kp DOWN      &kp RIGHT            &kp C_PP    &kp C_MUTE
&trans      &trans          &trans          &none           &none            &none            &trans                    &mmv MOVE_DOWN                   &trans  &DecreaseMouseSpeed  &none         &IncreaseMouseSpeed  &kp C_PREV  &kp C_VOLUME_DOWN
                                            &mkp MCLK       &mkp RCLK        &mkp LCLK                                                                   &trans  &trans               &kp DEL
            >;

            sensor-bindings =
                <&inc_dec_kp C_AC_SCROLL_UP C_AC_SCROLL_DOWN>,
                <&rsr_trans>;
        };

        System {
            display-name = "System";
            bindings = <
&soft_off        &sys_reset       &none            &none            &out OUT_USB     &out OUT_BLE                                &mmv MOVE_UP                     &tog 0  &tog 4  &none   &none  &none  &bootloader
&bt BT_CLR       &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &none   &none   &none   &none  &none  &none
&rgb_ug RGB_TOG  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &none         &kp C_MUTE                    &mmv MOVE_DOWN                   &none   &none   &none   &none  &none  &none
                                                   &trans           &trans           &trans                                                                       &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        G_Main {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E         &kp R  &kp T                                    &mmv MOVE_UP                     &kp Y      &kp U   &kp I      &kp O    &kp P     &kp EQUAL
&kp LCTRL  &kp A  &kp S  &kp D         &kp F  &kp G                    &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp H      &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C         &kp V  &kp B      &kp C_MUTE                    &mmv MOVE_DOWN                   &kp N      &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp MINUS
                         &ALT_WINDOWS  &mo 5  &kp SPACE                                                                 &kp SPACE  &tog 0  &kp BSPC
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            label = "G_Main";
        };

        G_Num {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                                &mmv MOVE_UP                     &kp F1     &kp F2   &kp F3   &kp F4  &kp F5   &trans
&kp LCTRL  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp F6     &kp F7   &kp F8   &kp F9  &kp F10  &trans
&kp LSHFT  &trans  &trans  &trans  &trans  &trans  &kp C_MUTE                    &mmv MOVE_DOWN                   &kp F11    &kp F12  &trans   &trans  &trans   &trans
                           &trans  &trans  &trans                                                                 &kp ENTER  &trans   &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            label = "G_Num";
        };
    };
};
